rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /item_images/{uid}/{itemId}/{fileName} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024; }
    match /profile_images/{uid}/{fileName} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
  }
}
